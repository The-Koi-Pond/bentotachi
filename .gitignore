node_modules/

# PocketBase program and its zip contents (downloaded separately, see README)
server/pocketbase
server/pocketbase.exe
server/CHANGELOG.md
server/LICENSE.md
server/*.zip

# The live database and uploaded photos. Back these up; never commit them.
server/pb_data/

# Built app (made by "npm run build")
server/pb_public/

# TypeScript build cache
*.tsbuildinfo

# Android app build (made by "npm run android")
web/dist/

# Published Android app versions (made by "npm run release")
server/releases/

# Bento's signing key and its password. Back these up; never commit them.
web/android/keystore.properties
# The Google Play upload robot's key (uploads new versions to Play): like
# the signing key, it never goes on GitHub.
web/android/play-publisher.json
signing/
*.jks

# Copies of the live database made before risky changes. Never commit them.
backups/

# Zips of Bento made for friends (made by "npm run package")
share/

# This household's own setup: the Pi's address and login (see
# web/scripts/piConfig.mjs), and Claude's notes about the household.
web/scripts/pi.json
CLAUDE.local.md

# The phone server library (made by "npm run server-lib" from mobile/).
web/android/app/libs/bentoserver*

# Screenshots and page notes from browser testing (Playwright saves them
# inside the project folder).
.playwright-mcp/
