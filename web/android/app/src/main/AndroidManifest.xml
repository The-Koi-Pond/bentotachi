<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets Bento offer its own updates (Android still asks the person). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A step's timer buzzes when it's done (no prompt: Android grants it). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- allowBackup off: Android's own copy to Google can't hold a phone-only
         Bento reliably (it stops at 25 MB, and could copy the database
         mid-write), so Bento's Backups page is the one way, and the privacy
         policy can say nothing goes to Google. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Google Play fetches the barcode scanner (BentoScannerPlugin) when
             the app is installed from Play, so the first scan doesn't say
             it isn't ready yet. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Share to Bento": recipe links shared from other apps. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- A Paprika file (.paprikarecipes, a zip; .paprikarecipe, a
                 gzip) opened with Bento from Files, email or chat, or
                 shared to it: Android has no type of its own for them, so
                 the zip and "any file" types (BentoSharePlugin; the import
                 says if it isn't one). -->
            <intent-filter android:label="@string/import_label">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/gzip" />
            </intent-filter>

        </activity>

        <!-- Bento's built-in browser (Browse tab, "Save to Bento"). -->
        <activity
            android:name=".BrowserActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
