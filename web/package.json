{
  "name": "cookbook-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node scripts/run-tests.mjs",
    "android": "node scripts/server-lib.mjs && tsc -b && vite build --outDir dist --emptyOutDir && cap sync android",
    "server-lib": "node scripts/server-lib.mjs",
    "release": "node scripts/release.mjs",
    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@dnd-kit/core": "^6.3.1",
    "fflate": "^0.8.3",
    "pocketbase": "^0.28.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
